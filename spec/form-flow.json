{
  "version": "1.0.0",
  "product": "ASSESSORIA",
  "live_preview": {
    "enabled": true,
    "desktop_persistent": true,
    "desktop_form_width_percent_target": 42,
    "desktop_preview_width_percent_target": 58,
    "mobile_mode": "PREVIEW_TABS",
    "mobile_tabs": ["Preenchimento", "Contrato"],
    "uses_final_renderer": true,
    "raw_placeholders_visible": false,
    "pending_values_are_ui_only": true,
    "change_highlight_seconds_range": [1.5, 3.0]
  },
  "steps": [
    {
      "id": "contractor",
      "title": "Contratante",
      "fields": [
        {"path":"contractor_type","component":"segmented","label":"Tipo de contratante","options":["PF","PJ"],"required":true},
        {"path":"individual_contractors","component":"repeatable-person-stepper","label":"Contratantes PF","visible_when":"contractor_type == PF","min_items":1,"required_when":"contractor_type == PF","progress_pattern":"Contratante {current} de {total}"},
        {"path":"legal_entity","component":"legal-entity-card","label":"Pessoa Jurídica","visible_when":"contractor_type == PJ","required_when":"contractor_type == PJ"},
        {"path":"legal_entity.representatives","component":"repeatable-representative-stepper","label":"Representantes legais","visible_when":"contractor_type == PJ","min_items":1,"required_when":"contractor_type == PJ","progress_pattern":"Representante {current} de {total}","badge":"Signatário obrigatório"},
        {"path":"communication.whatsapp_main","component":"tel","label":"WhatsApp principal","required":true}
      ]
    },
    {
      "id": "scope",
      "title": "Escopo",
      "fields": [
        {"path":"scope.areas_count","component":"number","label":"Quantidade de áreas","required":true,"min":1,"manual_when":">= 4"},
        {"path":"scope.media_channels","component":"multi-select","label":"Canais de mídia","required":true,"options":["GOOGLE_ADS","META_ADS","LINKEDIN_ADS","TIKTOK_ADS","GPT_ADS","OTHER"]},
        {"path":"scope.other_media_channel","component":"text","label":"Qual outro canal?","visible_when":"scope.media_channels contains OTHER","required_when":"scope.media_channels contains OTHER"},
        {"path":"scope.media_cap_brl","component":"currency","label":"Teto mensal de mídia gerenciada","required":true,"min_exclusive":0},
        {"path":"scope.landing_page_included","component":"switch","label":"Landing Page incluída","required":true,"default":false},
        {"path":"scope.landing_pages_quantity","component":"number","label":"Quantidade de Landing Pages","visible_when":"scope.landing_page_included == true","required_when":"scope.landing_page_included == true","min":1,"helper":"Entrega inicial. A renovação automática não repõe Landing Pages."},
        {"path":"scope.creatives_quantity","component":"number","label":"Quantidade total de criativos por período","required":true,"min":0,"helper":"Peças estáticas e vídeos compartilham os slots. Roteiro e edição estão incluídos no slot do vídeo."},
        {"path":"scope.rota_academy_included","component":"switch","label":"Rota Academy incluída","required":true,"default":true},
        {"path":"scope.flowjuris_included","component":"switch","label":"Flowjuris incluído","required":true,"default":true}
      ]
    },
    {
      "id": "term",
      "title": "Vigência",
      "fields": [
        {"path":"dates.signature_date","component":"date","label":"Data de assinatura","required":true},
        {"path":"dates.service_start_date","component":"date","label":"Data de início da prestação","required":true,"helper":"Independente da data de assinatura."},
        {"path":"term.term_months","component":"select","label":"Vigência","required":true,"options":[3,6,12]},
        {"path":"term.fidelity_months","component":"number","label":"Fidelidade","required":true,"min":3,"max_dynamic":"term.term_months","helper":"Mínimo de 3 meses e nunca superior à vigência."}
      ]
    },
    {
      "id": "commercial",
      "title": "Financeiro",
      "fields": [
        {"path":"commercial.monthly_fee_brl","component":"currency","label":"Mensalidade da Assessoria","required":true,"min_exclusive":0},
        {"path":"payment.method","component":"select","label":"Forma de pagamento","required":true,"options":["BOLETO_PIX","CREDIT_CARD_RECURRING"]},
        {"path":"dates.first_invoice_date","component":"date","label":"Data da primeira fatura","required":true},
        {"path":"payment.recurring_due_day","component":"number","label":"Dia de vencimento das faturas seguintes","required":true,"min":1,"max":31},
        {"path":"setup.status","component":"segmented","label":"Setup operacional","required":true,"options":["CHARGED","EXEMPT"]},
        {"path":"setup.payment_method","component":"select","label":"Forma de pagamento do setup","visible_when":"setup.status == CHARGED","required_when":"setup.status == CHARGED","options":["BOLETO_PIX_WITH_MONTHLY","CREDIT_CARD"]},
        {"path":"setup.payment_date","component":"date","label":"Data de pagamento do setup","visible_when":"setup.status == CHARGED","required_when":"setup.status == CHARGED"}
      ],
      "derived_cards": [
        "derived.initial_term_reference_value_brl",
        "derived.nominal_fidelity_value_brl",
        "derived.setup_value_brl",
        "derived.implementation_business_days"
      ]
    },
    {
      "id": "review",
      "title": "Revisão",
      "tabs": ["Dados", "Cláusulas acionadas", "Contrato em tela cheia"],
      "read_only_clause_text": true,
      "primary_action": "REVIEW_AND_GENERATE",
      "primary_action_label": "REVISAR E GERAR CONTRATO",
      "review_modal": {
        "required": true,
        "title": "Confira as condições do contrato",
        "summary_fields": [
          "contractor_and_signers",
          "areas_count",
          "implementation_business_days",
          "media_channels",
          "media_cap",
          "landing_pages",
          "creatives_per_period",
          "rota_academy",
          "flowjuris",
          "signature_date",
          "service_start_date",
          "term_months",
          "fidelity_months",
          "monthly_fee",
          "initial_term_reference_value",
          "payment_method",
          "first_invoice_date",
          "recurring_due_day",
          "setup_status",
          "setup_payment_method_when_applicable",
          "setup_payment_date_when_applicable"
        ],
        "confirmation_checkbox_required": true,
        "confirmation_label": "Confirmo que revisei os dados e as condições acima.",
        "generate_button_label": "GERAR CONTRATO",
        "generate_enabled_when": "payload valid AND full render valid AND confirmation checked",
        "approval_snapshot": ["payload_hash", "render_hash", "approved_at"],
        "confirmation_performs_external_write": false
      }
    },
    {
      "id": "generation",
      "title": "Geração",
      "entry_requires_state": "HUMAN_APPROVED",
      "actions": ["Gerar PDF", "Criar no ClickUp", "Enviar à ZapSign"],
      "action_order": ["Gerar PDF", "Criar no ClickUp", "Enviar à ZapSign"],
      "external_actions_are_separate": true,
      "mock_default": true,
      "live_requires_confirmation": true,
      "invalidate_before_external_write_when": "current_payload_hash != approval_payload_hash OR current_render_hash != approval_render_hash"
    }
  ]
}
