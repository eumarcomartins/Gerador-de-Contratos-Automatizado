{"version":"1.0.0","states":[{"id":"DRAFT","external_write":false},{"id":"VALIDATED","external_write":false},{"id":"MANUAL_REQUIRED","external_write":false,"terminal_for_auto_generation":true},{"id":"RENDERED","external_write":false},{"id":"HUMAN_APPROVED","external_write":false},{"id":"PDF_READY","external_write":false},{"id":"CLICKUP_CREATED","external_write":true},{"id":"SIGNATURE_READY","external_write":false},{"id":"SENT_FOR_SIGNATURE","external_write":true},{"id":"PARTIALLY_SIGNED","external_write":false},{"id":"SIGNED","external_write":false,"terminal":true},{"id":"REJECTED","external_write":false,"terminal":true},{"id":"CANCELLED","external_write":false,"terminal":true},{"id":"INTEGRATION_ERROR","external_write":false}],"transitions":[{"from":"DRAFT","to":"VALIDATED","when":"all validation rules pass and areas_count <=3"},{"from":"DRAFT","to":"MANUAL_REQUIRED","when":"areas_count >=4"},{"from":"VALIDATED","to":"RENDERED","when":"clause resolution + rendering + final validation pass"},{"from":"RENDERED","to":"HUMAN_APPROVED","when":"explicit human approval in UI"},{"from":"HUMAN_APPROVED","to":"PDF_READY","when":"deterministic PDF generation succeeds"},{"from":"PDF_READY","to":"CLICKUP_CREATED","when":"ClickUp write confirmed and adapter succeeds; MOCK simulates"},{"from":"CLICKUP_CREATED","to":"SIGNATURE_READY","when":"signer resolution and document package pass final checks"},{"from":"SIGNATURE_READY","to":"SENT_FOR_SIGNATURE","when":"ZapSign write confirmed and adapter succeeds; MOCK simulates"},{"from":"SENT_FOR_SIGNATURE","to":"PARTIALLY_SIGNED","when":"at least one but not all required signers signed"},{"from":"SENT_FOR_SIGNATURE","to":"SIGNED","when":"all required signers signed"},{"from":"PARTIALLY_SIGNED","to":"SIGNED","when":"all required signers signed"},{"from":"SENT_FOR_SIGNATURE","to":"REJECTED","when":"provider reports rejection"},{"from":"PARTIALLY_SIGNED","to":"REJECTED","when":"provider reports rejection"},{"from":"CLICKUP_CREATED","to":"INTEGRATION_ERROR","when":"subsequent external integration fails"},{"from":"SIGNATURE_READY","to":"INTEGRATION_ERROR","when":"ZapSign creation fails"},{"from":"INTEGRATION_ERROR","to":"SIGNATURE_READY","when":"safe retry requested after ZapSign failure and ClickUp already exists"},{"from":"INTEGRATION_ERROR","to":"PDF_READY","when":"safe retry requested after ClickUp failure"}],"guards":["No transition to an external-write state before HUMAN_APPROVED.","MANUAL_REQUIRED can never transition to RENDERED automatically.","Every external write requires idempotency key and explicit confirmation in LIVE.","Automated tests may only use MOCK transitions for external-write states."]}
