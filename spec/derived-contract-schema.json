{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rota-juridica.local/schemas/assessoria-contract-derived.schema.json",
  "title": "Rota Jurídica - Derived Contract Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation_business_days",
    "initial_term_reference_value_cents",
    "nominal_fidelity_value_cents",
    "setup_value_cents",
    "resolved_clause_ids",
    "signers"
  ],
  "properties": {
    "implementation_business_days": {"type":"integer","enum":[7,10,15]},
    "initial_term_reference_value_cents": {"type":"integer","minimum":1},
    "nominal_fidelity_value_cents": {"type":"integer","minimum":1},
    "setup_value_cents": {"type":"integer","enum":[0,100000]},
    "resolved_clause_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "signers": {
      "type":"array",
      "minItems":2,
      "items": {
        "type":"object",
        "additionalProperties":false,
        "required":["role","name"],
        "properties": {
          "role":{"type":"string","enum":["CLIENT_PF","PJ_REPRESENTATIVE","CONTRACTOR_REPRESENTATIVE"]},
          "name":{"type":"string"},
          "cpf":{"type":["string","null"]},
          "email":{"type":["string","null"]},
          "legal_entity_name":{"type":["string","null"]}
        }
      }
    },
    "payload_hash": {"type":"string","pattern":"^sha256:"},
    "rendered_contract_html": {"type":"string"},
    "render_hash": {"type":"string","pattern":"^sha256:"},
    "workflow_state": {
      "type":"string",
      "enum":["DRAFT","VALIDATED","MANUAL_REQUIRED","RENDERED","HUMAN_APPROVED","PDF_READY","CLICKUP_CREATED","SIGNATURE_READY","SENT_FOR_SIGNATURE","PARTIALLY_SIGNED","SIGNED","REJECTED","CANCELLED","INTEGRATION_ERROR"]
    },
    "approval": {
      "type":["object","null"],
      "additionalProperties":false,
      "required":["payload_hash","render_hash","approved_at"],
      "properties": {
        "payload_hash":{"type":"string","pattern":"^sha256:"},
        "render_hash":{"type":"string","pattern":"^sha256:"},
        "approved_at":{"type":"string","format":"date-time"}
      }
    }
  }
}
