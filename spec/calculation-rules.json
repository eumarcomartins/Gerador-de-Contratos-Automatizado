{"version":"1.0.0","money_precision":"BRL cents; no authoritative binary floating point","rules":[{"id":"CR-001","name":"implementation_business_days","formula":"areas 1=>7; 2=>10; 3=>15; >=4=>MANUAL_CONTRACT_REQUIRED","notes":""},{"id":"CR-002","name":"initial_term_reference_value","formula":"monthly_fee_brl * term_months","notes":"Initial term only."},{"id":"CR-003","name":"nominal_fidelity_value","formula":"monthly_fee_brl * fidelity_months","notes":""},{"id":"CR-004","name":"setup_value","formula":"CHARGED ? 1000.00 : 0.00","notes":""},{"id":"CR-005","name":"calendar_month_daily_rate","formula":"monthly_fee_brl / actual_calendar_days_in_relevant_month","notes":""},{"id":"CR-006","name":"partial_service_value","formula":"calendar_month_daily_rate * service_days_in_same_calendar_month","notes":"Use 28/29/30/31 actual days."},{"id":"CR-007","name":"remaining_fidelity_balance","formula":"sum service-value obligations from effective termination boundary through fidelity end; partial months use CR-005/CR-006","notes":"Do not derive from amount already paid."},{"id":"CR-008","name":"early_termination_fidelity_fine","formula":"remaining_fidelity_balance * 0.20","notes":""},{"id":"CR-009","name":"late_payment_fine","formula":"overdue_installment_amount * 0.10","notes":""},{"id":"CR-010","name":"late_interest","formula":"1% per month pro rata die","notes":""},{"id":"CR-011","name":"renewal_term_months","formula":"same as original term_months","notes":""},{"id":"CR-012","name":"renewal_creatives_quantity","formula":"same as immediately preceding contractual period unless expressly amended","notes":""},{"id":"CR-013","name":"renewal_landing_pages_quantity","formula":"0","notes":"Landing Pages are initial deliverables."},{"id":"CR-014","name":"notice_waiver_amount_after_fidelity","formula":"1 * current_monthly_fee_brl","notes":"Accrued/proportional service obligations separate."}],"examples":[{"id":"CR-EX-001","input":{"monthly_fee_brl":3000,"calendar_days":30,"service_days":12},"output":{"daily_rate_brl":100,"proportional_value_brl":1200}},{"id":"CR-EX-002","input":{"monthly_fee_brl":3100,"calendar_days":31,"service_days":10},"output":{"daily_rate_brl":100,"proportional_value_brl":1000}}]}
